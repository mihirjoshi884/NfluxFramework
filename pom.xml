<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>io.github.mihirjoshi884</groupId>
    <artifactId>NfluxFramework</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>NfluxFramework</name>
    <description>The NfluxFramework is an API orchestration tool designed to manage complex, multi-step API workflows. It uses a Directed Acyclic Graph (DAG) to map dependencies, ensuring that APIs are executed in the correct order. The framework simplifies tasks like data mapping between API calls, managing authentication, and handling various response formats—including binary data—in a consistent, predictable manner. It is built to be a reliable and flexible solution for developers needing to automate and streamline their application's API interactions.</description>
    <url>https://github.com/mihirjoshi884/NfluxFramework</url>

    <!-- This section contains the license information -->
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://github.com/mihirjoshi884/NfluxFramework/blob/main/LICENSE</url>
        </license>
    </licenses>

    <!-- This section contains the developer information -->
    <developers>
        <developer>
            <name>Mihir Joshi</name>
            <email>mihirjoshi884@gmail.com</email>
            <organization>io.github.mihirjoshi884</organization>
            <organizationUrl>https://github.com/mihirjoshi884/NfluxFramework</organizationUrl>
        </developer>
    </developers>

    <!-- This section contains the SCM (Source Control Management) information -->
    <scm>
        <connection>scm:git:git://github.com/mihirjoshi884/NfluxFramework.git</connection>
        <developerConnection>scm:git:ssh://github.com:mihirjoshi884/NfluxFramework.git</developerConnection>
        <url>https://github.com/mihirjoshi884/NfluxFramework</url>
    </scm>

    <properties>
        <java.version>17</java.version>
        <!-- Plugin versions updated to recent stable versions for better compatibility -->
        <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.3.0</maven-surefire-plugin.version>
        <maven-gpg-plugin.version>3.2.4</maven-gpg-plugin.version>
        <maven-javadoc-plugin.version>3.8.0</maven-javadoc-plugin.version>
        <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
        <central-publishing-maven-plugin.version>0.8.0</central-publishing-maven-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.9.1</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Maven Compiler Plugin to handle Java version and Lombok annotations -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Spring Boot Plugin to create an executable JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Maven Source Plugin to create a sources JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven-source-plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Maven Javadoc Plugin to create a Javadoc JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven-javadoc-plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Maven GPG Plugin to sign artifacts for deployment -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>${maven-gpg-plugin.version}</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                        <configuration>
                            <!-- Use the GPG key ID that you are using -->
                            <keyname>A27C960D886AA35DC749E1936646D1B0577C2A76</keyname>
                            <!-- Use batch mode to prevent interactive prompts -->
                            <passphraseServerId>A27C960D886AA35DC749E1936646D1B0577C2A76</passphraseServerId>
                        </configuration>
                    </execution>
                </executions>
            </plugin>


            <!-- The new Central Publishing Plugin -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>${central-publishing-maven-plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>true</autoPublish>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- The distribution management section is no longer needed with the new plugin -->
    <distributionManagement>
        <repository>
            <id>central</id>
            <name>Central Publishing Repository</name>
            <url>https://central.sonatype.com/publishing/for-oss-projects/api/v1</url>
        </repository>
        <snapshotRepository>
            <id>central</id>
            <name>Central Publishing Snapshot Repository</name>
            <url>https://central.sonatype.com/publishing/for-oss-projects/api/v1</url>
        </snapshotRepository>
    </distributionManagement>

</project>
